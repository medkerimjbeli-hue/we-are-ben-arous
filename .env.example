# Copy to .env.local for local development. NEVER commit real .env files.
#
# PUBLIC (safe in the browser bundle — protected by Row Level Security):
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public site base path. "/" locally or on a custom domain; "/<repo-name>/" on GitHub Pages.
VITE_BASE_PATH=/
# Absolute public URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph. Leave empty if unknown.
VITE_SITE_URL=
#
# SECRET — NEVER put these in any VITE_* variable, .env file in the repo, or GitHub Pages workflow:
#   SUPABASE_SERVICE_ROLE_KEY, database password, Instagram/Meta access tokens.
